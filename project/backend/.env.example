# 本地开发环境变量模板
# 使用：复制为 .env 后生效（.env 已被 .gitignore 忽略，严禁提交）
# 生产环境一律由部署平台注入，严禁在仓库内提交真实凭据

PORT=2010
NODE_ENV=development

# MySQL（仅本地开发默认值；生产必须由环境注入替换）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=glitch_detective
DB_USER=gd_app
DB_PASSWORD=Gd@Bug2026

# Redis（本地默认，无密码；仅缓存与瞬时数据，业务数据全量落 MySQL）
REDIS_HOST=localhost
REDIS_PORT=6379
